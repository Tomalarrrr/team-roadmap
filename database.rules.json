{
  "rules": {
    "roadmap": {
      ".read": true,
      ".write": true,
      "projects": {
        "$projectId": {
          ".validate": "newData.hasChildren(['id', 'title', 'owner', 'startDate', 'endDate', 'statusColor'])",
          "id": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
          "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
          "owner": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
          "startDate": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
          "endDate": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
          "statusColor": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9A-Fa-f]{6}$/)" },
          "size": { ".validate": "newData.isString() && (newData.val() == 'full-time' || newData.val() == 'large' || newData.val() == 'medium' || newData.val() == 'small')" },
          "epr": { ".validate": "newData.isBoolean()" },
          "programme": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50" },
          "baselineEndDate": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
          "statusSetOn": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
          "tags": {
            ".validate": true,
            "$tag": { ".validate": "$tag.matches(/^1?[0-9]$/) && newData.isString() && newData.val().length > 0 && newData.val().length <= 50" }
          },
          "scoring": {
            ".validate": "newData.hasChildren(['scores', 'total'])",
            "scores": {
              "$criterion": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" }
            },
            "total": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 21" },
            "$other": { ".validate": false }
          },
          "milestones": {
            "$milestoneId": {
              ".validate": "newData.hasChildren(['id', 'title', 'startDate', 'endDate', 'statusColor'])",
              "id": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
              "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
              "description": { ".validate": "newData.isString() && newData.val().length <= 1000" },
              "startDate": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
              "endDate": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
              "statusColor": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9A-Fa-f]{6}$/)" },
              "tags": {
                ".validate": true,
                "$tag": { ".validate": "newData.isString() && newData.val().length <= 50" }
              },
              "$other": { ".validate": false }
            }
          },
          "dependencies": { ".validate": true },
          "$other": { ".validate": false }
        }
      },
      "teamMembers": {
        "$memberId": {
          ".validate": "newData.hasChildren(['id', 'name'])",
          "id": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
          "jobTitle": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "nameColor": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9A-Fa-f]{6}$/)" },
          "order": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200" },
          "left": { ".validate": "newData.isBoolean()" },
          "capacity": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4" },
          "$other": { ".validate": false }
        }
      },
      "dependencies": {
        "$depId": {
          ".validate": "newData.hasChildren(['id', 'fromProjectId', 'toProjectId', 'type'])",
          "id": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
          "fromProjectId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
          "fromMilestoneId": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "toProjectId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
          "toMilestoneId": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "type": { ".validate": "newData.isString() && (newData.val() == 'finish-to-start' || newData.val() == 'start-to-start' || newData.val() == 'finish-to-finish')" },
          "waypoints": {
            ".validate": true,
            "$wp": {
              ".validate": "newData.hasChildren(['x', 'y'])",
              "x": { ".validate": "newData.isNumber()" },
              "y": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        }
      },
      "leaveBlocks": {
        "$leaveId": {
          ".validate": "newData.hasChildren(['id', 'memberId', 'startDate', 'endDate', 'coverage', 'type'])",
          "id": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
          "memberId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
          "startDate": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
          "endDate": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
          "coverage": { ".validate": "newData.isString() && (newData.val() == 'quarter' || newData.val() == 'half' || newData.val() == 'full')" },
          "type": { ".validate": "newData.isString() && (newData.val() == 'annual-leave' || newData.val() == 'training' || newData.val() == 'conference' || newData.val() == 'other')" },
          "label": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "$other": { ".validate": false }
        }
      },
      "periodMarkers": {
        "$markerId": {
          ".validate": "newData.hasChildren(['id', 'startDate', 'endDate', 'color'])",
          "id": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
          "startDate": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
          "endDate": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
          "color": { ".validate": "newData.isString() && (newData.val() == 'grey' || newData.val() == 'yellow' || newData.val() == 'orange' || newData.val() == 'red' || newData.val() == 'green')" },
          "label": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "$other": { ".validate": false }
        }
      },
      "settings": {
        "graceDays": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60" },
        "recoveryDays": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60" },
        "programmes": {
          ".validate": true,
          "$i": { ".validate": "$i.matches(/^[12]?[0-9]$/) && newData.isString() && newData.val().length > 0 && newData.val().length <= 50" }
        },
        "$other": { ".validate": false }
      },
      "$other": { ".validate": false }
    },

    "presence": {
      ".read": true,
      "$sessionId": {
        ".write": true,
        ".validate": "newData.hasChildren(['id', 'name', 'color', 'lastSeen'])",
        "id": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
        "color": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9A-Fa-f]{6}$/)" },
        "lastSeen": { ".validate": "newData.isNumber()" },
        "editingProjectId": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "$other": { ".validate": false }
      }
    },

    "ludo": {
      ".read": true,
      "$gameCode": {
        ".write": true,
        ".validate": "newData.hasChildren(['players', 'tokens', 'currentTurn', 'createdAt', 'playerCount']) && newData.child('playerCount').val() >= 1 && newData.child('playerCount').val() <= 4 && newData.child('tokens').val().length == 48",
        "tokens": {
          ".validate": "newData.isString() && newData.val().length == 48 && newData.val().matches(/^(bas|t[0-9]{2}|f[0-9]{2})+$/)"
        },
        "currentTurn": {
          ".validate": "newData.isString() && (newData.val() == 'red' || newData.val() == 'green' || newData.val() == 'yellow' || newData.val() == 'blue')"
        },
        "turnPhase": {
          ".validate": "newData.isString() && (newData.val() == 'roll' || newData.val() == 'move')"
        },
        "diceValue": {
          ".validate": "!newData.exists() || newData.val() === null || (newData.isNumber() && newData.val() >= 1 && newData.val() <= 12)"
        },
        "consecutiveSixes": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
        },
        "winner": {
          ".validate": "!newData.exists() || newData.val() === null || (newData.isString() && (newData.val() == 'red' || newData.val() == 'green' || newData.val() == 'yellow' || newData.val() == 'blue'))"
        },
        "playerCount": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "turnStartedAt": { ".validate": "newData.isNumber()" },
        "startedAt": { ".validate": "!newData.exists() || newData.val() === null || newData.isNumber()" },
        "finishOrder": { ".validate": "newData.isString() && newData.val().length <= 50" },
        "singlePlayer": { ".validate": "newData.isBoolean()" },
        "paused": { ".validate": "newData.isBoolean()" },
        "pausedAt": { ".validate": "!newData.exists() || newData.val() === null || newData.isNumber()" },
        "players": {
          ".validate": "newData.hasChild('red')",
          "$color": {
            ".validate": "newData.hasChildren(['sessionId', 'name'])",
            "sessionId": { ".validate": "newData.isString() && newData.val().length <= 100" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 50" },
            "$other": { ".validate": false }
          }
        },
        "powerUpsEnabled": { ".validate": "newData.isBoolean()" },
        "powerUps": {
          ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 500 && newData.val().matches(/^[A-Z_]{8,}$/)"
        },
        "boardEffects": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "activeBuffs": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "coins": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9,:]+$/) && newData.val().length <= 20"
        },
        "mysteryBoxes": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "flag": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "rollStats": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "$other": { ".validate": false }
      }
    },

    "ludo3": {
      ".read": true,
      "$gameCode": {
        ".write": true,
        ".validate": "newData.hasChildren(['players', 'tokens', 'currentTurn', 'createdAt', 'playerCount']) && newData.child('playerCount').val() >= 1 && newData.child('playerCount').val() <= 3 && newData.child('tokens').val().length == 45",
        "tokens": {
          ".validate": "newData.isString() && newData.val().length == 45 && newData.val().matches(/^(bas|t[0-9]{2}|f[0-9]{2})+$/)"
        },
        "currentTurn": {
          ".validate": "newData.isString() && (newData.val() == 'red' || newData.val() == 'green' || newData.val() == 'blue')"
        },
        "turnPhase": {
          ".validate": "newData.isString() && (newData.val() == 'roll' || newData.val() == 'move')"
        },
        "diceValue": {
          ".validate": "!newData.exists() || newData.val() === null || (newData.isNumber() && newData.val() >= 1 && newData.val() <= 6)"
        },
        "lastRoll": {
          ".validate": "!newData.exists() || newData.val() === null || (newData.isNumber() && newData.val() >= 1 && newData.val() <= 6)"
        },
        "consecutiveSixes": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
        },
        "winner": {
          ".validate": "!newData.exists() || newData.val() === null || (newData.isString() && (newData.val() == 'red' || newData.val() == 'green' || newData.val() == 'blue'))"
        },
        "playerCount": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "turnStartedAt": { ".validate": "newData.isNumber()" },
        "startedAt": { ".validate": "!newData.exists() || newData.val() === null || newData.isNumber()" },
        "finishOrder": { ".validate": "newData.isString() && newData.val().length <= 50" },
        "singlePlayer": { ".validate": "newData.isBoolean()" },
        "paused": { ".validate": "newData.isBoolean()" },
        "pausedAt": { ".validate": "!newData.exists() || newData.val() === null || newData.isNumber()" },
        "host": { ".validate": "!newData.exists() || newData.val() === null || (newData.isString() && (newData.val() == 'red' || newData.val() == 'green' || newData.val() == 'blue'))" },
        "players": {
          ".validate": "newData.hasChild('red') || newData.hasChild('green') || newData.hasChild('blue')",
          "$color": {
            ".validate": "newData.hasChildren(['sessionId', 'name'])",
            "sessionId": { ".validate": "newData.isString() && newData.val().length <= 100" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 50" },
            "$other": { ".validate": false }
          }
        },
        "rollStats": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "yardMisses": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "packDraws": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "packThrows": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "$other": { ".validate": false }
      }
    },

    "ludo4": {
      ".read": true,
      "$gameCode": {
        ".write": true,
        ".validate": "newData.hasChildren(['players', 'tokens', 'currentTurn', 'createdAt', 'playerCount']) && newData.child('playerCount').val() >= 1 && newData.child('playerCount').val() <= 4 && newData.child('tokens').val().length == 60",
        "tokens": {
          ".validate": "newData.isString() && newData.val().length == 60 && newData.val().matches(/^(bas|t[0-9]{2}|f[0-9]{2})+$/)"
        },
        "currentTurn": {
          ".validate": "newData.isString() && (newData.val() == 'red' || newData.val() == 'green' || newData.val() == 'yellow' || newData.val() == 'blue')"
        },
        "turnPhase": {
          ".validate": "newData.isString() && (newData.val() == 'roll' || newData.val() == 'move')"
        },
        "diceValue": {
          ".validate": "!newData.exists() || newData.val() === null || (newData.isNumber() && newData.val() >= 1 && newData.val() <= 6)"
        },
        "lastRoll": {
          ".validate": "!newData.exists() || newData.val() === null || (newData.isNumber() && newData.val() >= 1 && newData.val() <= 6)"
        },
        "consecutiveSixes": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
        },
        "winner": {
          ".validate": "!newData.exists() || newData.val() === null || (newData.isString() && (newData.val() == 'red' || newData.val() == 'green' || newData.val() == 'yellow' || newData.val() == 'blue'))"
        },
        "playerCount": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 4" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "turnStartedAt": { ".validate": "newData.isNumber()" },
        "startedAt": { ".validate": "!newData.exists() || newData.val() === null || newData.isNumber()" },
        "finishOrder": { ".validate": "newData.isString() && newData.val().length <= 50" },
        "singlePlayer": { ".validate": "newData.isBoolean()" },
        "paused": { ".validate": "newData.isBoolean()" },
        "pausedAt": { ".validate": "!newData.exists() || newData.val() === null || newData.isNumber()" },
        "host": { ".validate": "!newData.exists() || newData.val() === null || (newData.isString() && (newData.val() == 'red' || newData.val() == 'green' || newData.val() == 'yellow' || newData.val() == 'blue'))" },
        "players": {
          ".validate": "newData.hasChild('red') || newData.hasChild('green') || newData.hasChild('yellow') || newData.hasChild('blue')",
          "$color": {
            ".validate": "newData.hasChildren(['sessionId', 'name'])",
            "sessionId": { ".validate": "newData.isString() && newData.val().length <= 100" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 50" },
            "$other": { ".validate": false }
          }
        },
        "rollStats": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "yardMisses": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "packDraws": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "packThrows": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "$other": { ".validate": false }
      }
    },

    "snake": {
      ".read": true,
      "$code": {
        ".write": true,
        ".validate": "newData.hasChild('m')",
        "m": {
          ".validate": "newData.hasChildren(['status', 'createdAt', 'seed', 'players', 'round', 'startAt', 'scoreA', 'scoreB'])",
          "status": { ".validate": "newData.isString() && (newData.val() == 'waiting' || newData.val() == 'playing' || newData.val() == 'finished')" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "seed": { ".validate": "newData.isNumber()" },
          "round": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "startAt": { ".validate": "newData.isNumber()" },
          "scoreA": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99" },
          "scoreB": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99" },
          "winsA": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "winsB": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "lastWinner": { ".validate": "newData.isString() && (newData.val() == 'a' || newData.val() == 'b' || newData.val() == 'draw')" },
          "lastWhy": { ".validate": "newData.isString() && (newData.val() == 'crash' || newData.val() == 'clock')" },
          "winner": { ".validate": "newData.isString() && (newData.val() == 'a' || newData.val() == 'b')" },
          "gone": { ".validate": "newData.isString() && (newData.val() == 'a' || newData.val() == 'b')" },
          "players": {
            "$seat": {
              ".validate": "($seat == 'a' || $seat == 'b') && newData.hasChildren(['sessionId', 'name'])",
              "sessionId": { ".validate": "newData.isString() && newData.val().length <= 100" },
              "name": { ".validate": "newData.isString() && newData.val().length <= 50" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        },
        "s": {
          "$seat": {
            ".validate": "($seat == 'a' || $seat == 'b') && newData.hasChildren(['seq', 'at', 'round', 'k', 'path', 'len', 'dir', 'adj', 'ate'])",
            "seq": { ".validate": "newData.isNumber()" },
            "at": { ".validate": "newData.isNumber()" },
            "round": { ".validate": "newData.isNumber()" },
            "k": { ".validate": "newData.isNumber()" },
            "path": { ".validate": "newData.isString() && newData.val().length <= 1600" },
            "len": { ".validate": "newData.isNumber()" },
            "dir": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
            "dead": { ".validate": "newData.isNumber()" },
            "hit": { ".validate": "newData.isNumber()" },
            "adj": { ".validate": "newData.isNumber()" },
            "ate": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },

    "swarm": {
      ".read": true,
      "$code": {
        ".write": "!data.exists() || (!newData.exists() && (data.child('m/status').val() != 'playing' || ((!data.hasChild('m/players/a') || data.hasChild('m/out/a')) && (!data.hasChild('m/players/b') || data.hasChild('m/out/b')) && (!data.hasChild('m/players/c') || data.hasChild('m/out/c')) && (!data.hasChild('m/players/d') || data.hasChild('m/out/d'))) || (data.child('m/createdAt').val() < now - 86400000 && (!data.hasChild('s/a/at') || data.child('s/a/at').val() < now - 300000) && (!data.hasChild('s/b/at') || data.child('s/b/at').val() < now - 300000) && (!data.hasChild('s/c/at') || data.child('s/c/at').val() < now - 300000) && (!data.hasChild('s/d/at') || data.child('s/d/at').val() < now - 300000))))",
        ".validate": "newData.hasChild('m') && $code.matches(/^[A-Z0-9]{4}$/)",
        "m": {
          ".write": true,
